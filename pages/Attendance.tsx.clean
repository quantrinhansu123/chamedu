                  : 'bg-white text-gray-600 border-gray-300 hover:bg-gray-50'
              }`}
            >
              {showGradeFields ? 'Γ£ô Nhß║¡p ─æiß╗âm sß╗æ' : '+ Nhß║¡p ─æiß╗âm sß╗æ'}
            </button>
          </div>

          {/* Table */}
          <div className="overflow-x-auto">
          <table className="w-full text-left text-sm text-gray-600">
