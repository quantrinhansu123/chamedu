              <p className="text-xl font-bold text-gray-800">{stats.total}</p>
            </div>
            <div className="p-4 text-center bg-gray-50">
              <p className="text-xs text-gray-500 uppercase font-bold">Ch╞░a ─æiß╗âm danh</p>
              <p className="text-xl font-bold text-gray-600">{stats.pending}</p>
            </div>
            <div className="p-4 text-center bg-green-50">
              <p className="text-xs text-green-600 uppercase font-bold">C├│ mß║╖t</p>
