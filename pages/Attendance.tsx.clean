        <div className="bg-red-100 border-2 border-red-400 rounded-lg p-4 flex items-start gap-3 text-red-800">
          <AlertTriangle size={24} className="flex-shrink-0 mt-0.5" />
          <div className="flex-1">
            <p className="font-bold text-lg">KH├öNG THß╗é ─ÉIß╗éM DANH - NG├ÇY KH├öNG Hß╗óP Lß╗å</p>
            <p className="mt-1">
              Ng├áy {new Date(attendanceDate).toLocaleDateString('vi-VN')} kh├┤ng nß║▒m trong lß╗ïch hß╗ìc cß╗ºa lß╗¢p 
              {selectedClass?.schedule && <> (Lß╗ïch: {formatSchedule(selectedClass.schedule)})</>}.
            </p>
            <p className="text-sm mt-2 text-red-600">
              Bß║ín chß╗ë c├│ thß╗â ─æiß╗âm danh v├áo c├íc ng├áy trong lß╗ïch hß╗ìc hoß║╖c c├íc ng├áy ─æ├ú ─æiß╗âm danh tr╞░ß╗¢c ─æ├│.
            </p>
          </div>
        </div>
      )}

      {/* Holiday Warning - BLOCKING */}
      {selectedDateHoliday && (
        <div className="bg-red-100 border-2 border-red-400 rounded-lg p-4 flex items-start gap-3 text-red-800">
